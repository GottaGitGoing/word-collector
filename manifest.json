{
  "manifest_version": 3,
  "name": "Word Collector",
  "version": "1.1.0",
  "description": "Double-click or highlight any word to save it with its English translation.",
  "permissions": ["storage", "clipboardRead", "notifications", "scripting", "activeTab"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "highlight.js"],
      "css": ["content.css"]
    }
  ],
  "commands": {
    "save-clipboard": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "MacCtrl+S"
      },
      "description": "Translate and save text from clipboard"
    }
  },
  "action": { "default_popup": "popup.html" }
}